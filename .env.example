# Core runtime
NODE_ENV=production
PORT=3001
SERVICE_NAME=soundinfluencers-main
DATABASE_ROOT=mongodb://<user>:<password>@<mongo-host>:27017/<main-database>
REDIS_URL=redis://:<password>@<redis-host>:6379/0
REDIS_PREFIX=soundinfluencers:main
CORS_ORIGINS=https://<client-domain>,https://<admin-domain>
SERVER=https://<api-domain>
SERVER_CLIENT=https://<client-domain>
ADMIN_CLIENT=https://<admin-domain>

# Authentication and cookies (generate unique values per instance)
JWT_SECRET=<generate-a-long-random-secret>
JWT_REFRESH_SECRET=<generate-a-different-long-random-secret>
COOKIE_DOMAIN=<shared-cookie-domain-if-required>
COOKIE_SECURE=true
SERVER_API_ENCRYPTION_SECRET_KEY=<generate-a-long-random-secret>

# Cache and background processing
OFFERS_CACHE_TTL_MS=300000
NEGOTIATION_IMAP_ENABLED=false
NEGOTIATION_IMAP_POLL_INTERVAL_MS=60000
NEGOTIATION_INBOX_LOCAL=<mailbox-local-part>
NEGOTIATION_REPLY_DOMAIN=<reply-domain>

# Email and IMAP
EMAIL_USER=<smtp-user>
EMAIL_PASS=<smtp-password>
EMAIL_LOGIN_URL=https://<client-domain>/auth
EMAIL_DASHBOARD_URL=https://<client-domain>
EMAIL_CREATE_CAMPAIGN_URL=https://<client-domain>
EMAIL_HELP_CENTER_URL=https://<help-domain>
EMAIL_SUPPORT_URL=https://<support-domain>
ZOHO_IMAP_HOST=imap.zoho.eu
ZOHO_IMAP_PORT=993
ZOHO_IMAP_SECURE=true
ZOHO_IMAP_USER=<imap-user>
ZOHO_IMAP_PASS=<imap-password>

# External providers
APIFY_TOKEN=<apify-token>
BOTASSIUM_WEBHOOK_URL=https://<webhook-domain>/<path>
EXCHANGE_API_KEY=<exchange-api-key>
EXCHANGE_API_URL=https://<exchange-api-domain>
EXCHANGE_BASE=EUR
EXCHANGE_SYMBOLS=USD,GBP
GOOGLE_SERVICE_ACCOUNT_JSON=<single-line-json-service-account>
SQUARE_ACCESS_TOKEN=<square-token>
SQUARE_LOCATION_ID=<square-location-id>
STRIPE_KEY=<stripe-secret-key>
TWILIO_ACCOUNT_SID=<twilio-account-sid>
TWILIO_AUTH_TOKEN=<twilio-auth-token>
TWILIO_NEW_PROMO_REQUEST_TEMPLATE_SID=<twilio-template-sid>
TWILIO_SENDER=<twilio-sender>

# PDF rendering
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
PDF_CONCURRENCY=2
PDF_TIMEOUT_MS=60000

# Optional Swagger protection, if enabled by application policy
SWAGGER_LOGIN=<swagger-login>
SWAGGER_PASSWORD=<swagger-password>
